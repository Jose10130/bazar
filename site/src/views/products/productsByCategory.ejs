<!DOCTYPE html>
<html lang="es">
<%- include("../partials/head", { title: category ? category.name : "Categoría" }) %>

<body class="category-body">
  <%- include("../partials/header") %>

  <main class="category-main">
    <section class="category-topbar">
      <div class="category-topbar__info">
        <h1><%= category ? category.name : "Categoría" %></h1>
        <p><%= count %> producto<%= count !== 1 ? "s" : "" %> encontrado<%= count !== 1 ? "s" : "" %></p>
      </div>
    </section>

    <% if (products.length > 0) { %>
      <section class="section-products">
        <% products.forEach(product => { %>
          <div class="product-card <%= Number(product.quantity || 0) <= 0 ? 'product-card--out' : '' %>">
            <button class="add-to-favorites" data-product-id="<%= product.id %>" <%= !user ? "disabled" : "" %>>
              <% if (user && user.favorites) { %>
                <% const isFavorite = user.favorites.some(favorite => favorite.id === product.id); %>
                <i class="fa <%= isFavorite ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i>
              <% } else { %>
                <i class="fa fa-regular fa-heart"></i>
              <% } %>
            </button>

            <div class="product-image">
              <img src="/images/products/<%= product.image %>" alt="<%= product.name %>">
            </div>

            <% if (Number(product.quantity || 0) > 0) { %>
              <span class="stock-status stock-status--in">Disponible</span>
            <% } else { %>
              <span class="stock-status stock-status--out">Sin stock</span>
            <% } %>

            <div class="product-details">
              <h3 class="product-title"><%= product.name %></h3>
              <p class="product-description"><%= product.description %></p>

              <div class="product-price">
                <span class="price">$<%= product.price %></span>
              </div>

              <div class="product-actions">
                <a href="/productos/detalle/<%= product.id %>" class="view-product">Ver Producto</a>
                <% if (Number(product.quantity || 0) > 0) { %>
                  <button type="button" class="add-to-cart" data-product-id="<%= product.id %>" data-stock="<%= Number(product.quantity || 0) %>">Agregar al carrito</button>
                <% } else { %>
                  <button type="button" class="add-to-cart button-disabled" data-product-id="<%= product.id %>" data-stock="0" disabled>Sin stock</button>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </section>

      <% if (hasMore) { %>
        <div class="ver-mas-container">
          <a href="/productos/categoria/<%= category.id %>?page=<%= nextPage %>" class="ver-mas-btn">Ver más</a>
        </div>
      <% } %>
    <% } else { %>
      <section class="empty-products">
        <h2>No hay productos con la categoría seleccionada</h2>
      </section>
    <% } %>
  </main>

  <% if (locals.userLogin?.roleAdmin === true) { %>
    <a href="/admin/dashboard/productos" class="access-dashboard">
      <i class="fa-solid fa-user-gear"></i>
    </a>
  <% } else { %>
    <a href="https://www.whatsapp.com/" target="_blank">
      <div class="whatsapp-icon-fixed">
        <i class="fa-brands fa-whatsapp"></i>
        <div class="chat-bubble">¿Quieres contactarte con nosotros?</div>
      </div>
    </a>
  <% } %>

  <%- include("../partials/footer") %>
  <%- include("../partials/scripts") %>
</body>
</html>
