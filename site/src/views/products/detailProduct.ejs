<!DOCTYPE html>
<html lang="es">
<%- include("../partials/head", { title: product.name }) %>

<body>
  <%- include("../partials/header") %>

  <main class="home-main">
    <div class="div-fondo">
      <div class="card-container">
        <h2>Seleccionaste</h2>

        <div class="div-img">
          <img src="/images/products/<%= product.image %>" alt="<%= product.name %>">
        </div>

        <b><%= product.name %></b>
        <h5>$<%= product.price %></h5>
        <p>Categoría: <%= product.category.name %></p>

        <% if (Number(product.quantity || 0) > 0) { %>
          <span class="stock-status-inline stock-status-inline--in">Disponible</span>
          <button
            type="button"
            class="cart-button detail-add-to-cart"
            data-product-id="<%= product.id %>"
            data-stock="<%= Number(product.quantity || 0) %>">
            Agregar al carrito
          </button>
        <% } else { %>
          <span class="stock-status-inline stock-status-inline--out">Sin stock</span>
          <button type="button" class="cart-button is-disabled" disabled>Sin stock</button>
        <% } %>
      </div>
    </div>
  </main>

  <%- include("../partials/footer") %>
  <%- include("../partials/scripts") %>
</body>
</html>
