<!DOCTYPE html>
<html lang="es">
<%- include("../partials/head", { title: "Editar producto" }) %>
<body class="dashboard-body">
  <%- include("./navBar") %>

  <main class="edicion-producto">
    <section class="edit-product-card">
      <div class="edit-product-header">
        <div>
          <h2 class="h2-edit">Editar producto</h2>
          <p class="edit-product-subtitle">Actualizar datos del producto</p>
        </div>

        <div class="edit-product-code">
          <span>Código de barra</span>
          <strong><%= product.barcode || ('PRD-' + String(product.id).padStart(8, '0')) %></strong>
        </div>
      </div>

      <form action="/admin/dashboard/editar/<%= product.id %>?_method=PUT" enctype="multipart/form-data" method="POST" class="form-edit">
        <div class="edit-grid">
          <div class="mb-3">
            <label for="exampleInputPassword1" class="form-label">Nombre</label>
            <input
              name="name"
              value="<%= locals.old ? locals.old.name : product.name %>"
              type="text"
              class="form-control input-edicion"
              id="exampleInputPassword1"
              required>
            <p class="text-danger"><% if (locals.errors?.name) { %><%= locals.errors.name.msg %><% } %></p>
          </div>

          <div class="mb-3">
            <label for="exampleInputEmail1" class="form-label">Precio</label>
            <input
              name="price"
              value="<%= locals.old ? locals.old.price : product.price %>"
              type="number"
              step="0.01"
              min="0"
              class="form-control input-edicion"
              id="exampleInputEmail1"
              required>
            <p class="text-danger"><% if (locals.errors?.price) { %><%= locals.errors.price.msg %><% } %></p>
          </div>

          <div class="mb-3">
            <label for="exampleInputStock" class="form-label">Stock</label>
            <input
              name="stock"
              value="<%= locals.old ? locals.old.stock : product.quantity %>"
              type="number"
              min="0"
              step="1"
              class="form-control input-edicion"
              id="exampleInputStock"
              required>
            <p class="text-danger"><% if (locals.errors?.stock) { %><%= locals.errors.stock.msg %><% } %></p>
          </div>

          <div class="mb-3">
            <label for="inputGroupSelect01" class="form-label">Categoría</label>
            <select class="form-select input-edicion" id="inputGroupSelect01" name="category" required>
              <% categories.forEach(c => { %>
                <option
                  <%= Number((locals.old && locals.old.category) ? locals.old.category : product.categoryId) === Number(c.id) ? 'selected' : '' %>
                  value="<%= c.id %>">
                  <%= c.name %>
                </option>
              <% }) %>
            </select>
            <p class="text-danger"><% if (locals.errors?.category) { %><%= locals.errors.category.msg %><% } %></p>
          </div>

          <div class="mb-3 textarea-full">
            <label for="exampleFormControlTextarea1" class="form-label">Descripción</label>
            <textarea
              class="form-control input-edicion textarea-edit"
              name="description"
              id="exampleFormControlTextarea1"
              rows="4"
              required><%= locals.old ? locals.old.description : product.description %></textarea>
            <p class="text-danger"><% if (locals.errors?.description) { %><%= locals.errors.description.msg %><% } %></p>
          </div>

          <div class="mb-3 image-full">
            <label for="file" class="form-label">Imagen</label>

            <div class="current-image-box">
              <p class="current-image-label">Imagen actual</p>
              <img src="/images/products/<%= product.image %>" alt="imagen del producto" class="img-preview">
              <p class="image-helper">Si no elegís una nueva imagen, se mantiene la actual.</p>
            </div>

            <input class="form-control file-input" type="file" id="file" accept=".jpg,.jpeg,.png,image/*" name="imageProduct">
            <p class="text-danger"><% if (locals.errors?.imageProduct) { %><%= locals.errors.imageProduct.msg %><% } %></p>
          </div>
        </div>

        <div class="buttons">
          <button type="reset" class="btn btn-danger boton-borrar">Deshacer cambios</button>
          <button type="submit" class="btn btn-success boton-guardar">Guardar</button>
        </div>
      </form>

      <div class="button-volver">
        <a href="/admin/dashboard/productos" class="btn btn-primary">Volver</a>
      </div>
    </section>
  </main>

  <script src="/js/editPreview.js"></script>
  <%- include("../partials/scripts") %>
</body>
</html>
