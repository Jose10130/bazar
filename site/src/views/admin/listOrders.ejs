<!DOCTYPE html>
<html lang="es">
<%- include("../partials/head", { title: "Pedidos" }) %>

<body class="dashboard-body">
  <%- include("./navBar") %>

  <% 
    const stateLabels = {
      pending: "Pendiente",
      completed: "Finalizado",
      canceled: "Cancelado"
    };
  %>

  <main class="admin-main-list orders-page">
    <div class="admin-header-list">
      <div class="admin-header-list-title">
        <h2>Pedidos</h2>
      </div>
    </div>

    <div class="table-responsive orders-table-wrap">
      <table class="table table-borderless table-hover" id="table-orders">
        <thead class="table-dark">
          <tr>
            <th>ID de orden</th>
            <th>Total</th>
            <th>Usuario</th>
            <th>Estado</th>
            <th>Fecha de creación</th>
            <th>Última actualización</th>
            <th>Detalle</th>
            <th>Acción</th>
          </tr>
        </thead>

        <tbody>
          <% orders.forEach(order => { %>
            <tr>
              <td><%= order.id %></td>
              <td><%= Number(order.total || 0).toLocaleString("es-AR", { style: "currency", currency: "ARS" }) %></td>
              <td><%= order.user?.name || "" %> <%= order.user?.surname || "" %></td>
              <td>
                <span class="order-state-badge order-state-<%= order.state %>">
                  <%= stateLabels[order.state] || order.state %>
                </span>
              </td>
              <td><%= new Date(order.createdAt).toLocaleString("es-AR") %></td>
              <td><%= new Date(order.updatedAt).toLocaleString("es-AR") %></td>
              <td>
                <a href="/admin/dashboard/ordenes/<%= order.id %>" class="btn btn-success order-action-btn">
                  Ver detalle
                </a>
              </td>
              <td>
                <% if (order.state === "pending") { %>
                  <form action="/admin/dashboard/ordenes/<%= order.id %>/estado?_method=PUT" method="post">
                    <input type="hidden" name="state" value="canceled">
                    <button
                      type="submit"
                      class="btn btn-danger order-action-btn"
                      onclick="return confirm('¿Cancelar orden?')">
                      Cancelar orden
                    </button>
                  </form>
                <% } else { %>
                  <button type="button" class="btn btn-secondary order-action-btn" disabled>
                    No disponible
                  </button>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </main>

  <%- include("../partials/scripts") %>
</body>
</html>